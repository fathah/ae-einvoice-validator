# Service-only configuration. This project needs no Tanseek credentials or database.
VALIDATOR_IMAGE=ghcr.io/your-github-owner/ae-einvoice-validator:latest
VALIDATOR_BIND_PORT=8091
# Generate with: openssl rand -hex 32
# Required: 32-256 URL-safe characters. Keep the actual .env file out of Git.
EINVOICE_VALIDATOR_TOKEN=
